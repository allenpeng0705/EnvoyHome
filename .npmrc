# pnpm settings. See tests/min/conventions.md R9 and Plan §5.7.
#
# R9 forbids setting CI=true before `pnpm install` (pnpm reads it as strict mode:
# frozen-lockfile, postinstall failures, peer-dep warnings). But pnpm also refuses
# to purge a stale modules directory without a TTY, and its suggested workaround
# is exactly `CI=true`:
#
#   ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY
#   If you are running pnpm in CI, set the CI environment variable to "true",
#   or set "confirmModulesPurge" to "false".
#
# Take pnpm's second option so CI/non-interactive runs (scripts/ci.sh,
# .github/workflows/ci.yml, which explicitly `unset CI`) do not deadlock.
confirm-modules-purge=false
