[
  {
    "id": "gen-compose-complex-edit-export-schedule",
    "pack": "general",
    "mode": "compose",
    "live": false,
    "prompt": "Edit the draft, export PDF, then propose a reminder to send it.",
    "setup": {
      "sandboxFiles": true,
      "seedFiles": {
        "documents/cx-draft.md": "# Draft\n\nStatus: WIP\nToken: cx-draft-wip\n"
      }
    },
    "allowTools": ["read_file", "edit_file", "export_document", "schedule"],
    "rounds": [
      {
        "reply": "```envoyhome-tools\n[{\"tool\":\"read_file\",\"args\":{\"path\":\"documents/cx-draft.md\"}},{\"tool\":\"edit_file\",\"args\":{\"path\":\"documents/cx-draft.md\",\"oldString\":\"Status: WIP\\nToken: cx-draft-wip\",\"newString\":\"Status: Ready\\nToken: cx-draft-ready\"}}]\n```"
      },
      {
        "reply": "```envoyhome-tools\n[{\"tool\":\"export_document\",\"args\":{\"format\":\"pdf\",\"sourcePath\":\"documents/cx-draft.md\",\"title\":\"Draft\"}},{\"tool\":\"schedule\",\"args\":{\"action\":\"propose\",\"text\":\"tomorrow at 15:00 send the draft PDF\"}}]\n```"
      },
      {
        "reply": "Updated to Ready (cx-draft-ready), exported PDF, proposed 15:00 reminder — confirm when ready."
      }
    ],
    "expect": {
      "dispatchOrder": ["read_file", "edit_file", "export_document", "schedule"],
      "finalMatching": "cx-draft-ready|Ready|export|PDF|15:00|propos|confirm"
    }
  },
