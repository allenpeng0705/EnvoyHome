[
  {
    "id": "gen-compose-skills-list-then-view-rounds",
    "pack": "general",
    "mode": "compose",
    "live": true,
    "prompt": "List available skills, then open the morning brief skill and summarize it.",
    "setup": { "installSampleSkill": true },
    "allowTools": ["skills_list", "skill_view"],
    "rounds": [
      {
        "reply": "I'll list skills first.\n```envoyhome-tools\n[{\"tool\":\"skills_list\",\"args\":{}}]\n```"
      },
      {
        "reply": "Opening the brief.\n```envoyhome-tools\n[{\"tool\":\"skill_view\",\"args\":{\"id\":\"$skillId\",\"path\":\"SKILL.md\"}}]\n```"
      },
      {
        "reply": "The morning brief skill covers weather and coffee tips."
      }
    ],
    "expect": {
      "dispatchOrder": ["skills_list", "skill_view"],
      "minToolRounds": 2,
      "finalMatching": "weather|coffee|brief",
      "liveTools": ["skills_list", "skill_view"],
      "honestyMatching": ["skill|brief|weather"]
    }
  },
