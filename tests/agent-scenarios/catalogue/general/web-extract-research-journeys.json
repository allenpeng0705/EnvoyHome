  {
    "id": "gen-tool-web-extract-mock-page",
    "pack": "general",
    "mode": "tool",
    "live": false,
    "prompt": "Extract the article from example.com.",
    "setup": {
      "mockWebExtract": {
        "pages": {
          "https://example.com/article": "<!doctype html><html><head><title>EnvoyHome Extract Fixture</title></head><body><article><h1>EnvoyHome Extract Fixture</h1><p>This fixture page explains household web_extract for EnvoyHome agents with enough prose to pass the paragraph length filter.</p></article></body></html>"
        }
      }
    },
    "tool": {
      "name": "web_extract",
      "args": { "url": "https://example.com/article", "maxChars": 8000 }
    },
    "expect": {
      "toolOk": true,
      "jsonFields": ["url", "markdown", "chars"],
      "bodyMatching": "EnvoyHome Extract Fixture|household web_extract"
    }
  },
