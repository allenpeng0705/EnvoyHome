            "url": "https://example.com/eh-docs",
            "description": "Design docs."
          }
        ]
      },
      "mockWebExtract": {
        "pages": {
          "https://example.com/eh-docs": "<html><head><title>EnvoyHome docs</title></head><body><article><h1>EnvoyHome docs</h1><p>Normative Design for a household agent with memory, web_search, and optional web_research dig for Owners.</p></article></body></html>"
        }
      }
    },
    "allowTools": ["web_research"],
    "rounds": [
      {
        "reply": "```envoyhome-tools\n[{\"tool\":\"web_research\",\"args\":{\"query\":\"EnvoyHome\",\"digDepth\":1}}]\n```"
      },
      {
        "reply": "## Brief\nEnvoyHome docs describe a household agent with optional dig research.\n\n## Links\n1. EnvoyHome docs — https://example.com/eh-docs"
      }
    ],
    "expect": {
      "dispatchOrder": ["web_research"],
      "finalMatching": "EnvoyHome docs|eh-docs|Brief|Links"
    }
  },
