  {
    "id": "gen-seq-web-research-then-write-brief",
    "pack": "general",
    "mode": "tool",
    "live": false,
    "prompt": "Research then save a brief.",
    "setup": {
      "sandboxFiles": true,
      "webResearchEnabled": true,
      "digDepth": 1,
      "mockWebSearch": {
        "provider": "brave",
        "results": [
          {
            "title": "Shanghai weekend rain",
            "url": "https://example.com/sha-rain",
            "description": "Showers likely Saturday."
          }
        ]
      },
      "mockWebExtract": {
        "pages": {
          "https://example.com/sha-rain": "<html><head><title>Shanghai weekend rain</title></head><body><article><h1>Shanghai weekend rain</h1><p>Showers are likely on Saturday afternoon around the Huangpu riverfront with mild temperatures near twenty degrees.</p></article></body></html>"
        }
      }
    },
    "toolSequence": [
      {
        "name": "web_research",
        "args": { "query": "Shanghai Saturday rain", "digDepth": 1 }
      },
      {
        "name": "write_file",
        "args": {
          "path": "documents/wx-research.md",
          "content": "# Weekend brief\n\nShowers likely Saturday (from research).\n"
        }
      }
    ],
    "expect": {
      "sequenceOk": true,
      "step0": { "bodyMatching": "organized|Shanghai weekend rain|Showers" },
      "step1": { "bodyMatching": "ok|wx-research" }
    }
  },
