[
  {
    "id": "gen-seq-memory-remember-then-recall",
    "pack": "general",
    "mode": "tool",
    "live": false,
    "prompt": "Remember a standing fact then recall it (MemoryFacade — Design remember/recall tools).",
    "setup": { "sandboxFiles": true },
    "toolSequence": [
      {
        "name": "memory_remember",
        "args": {
          "text": "Household coffee preference is oat milk latte.",
          "target": "l2"
        }
      },
      {
        "name": "memory_recall",
        "args": { "query": "oat", "limit": 5 }
      }
    ],
    "expect": {
      "sequenceOk": true,
      "step0": { "jsonFields": ["ok", "layer"] },
      "step1": { "bodyMatching": "oat milk|coffee preference" }
    }
  },
  {
    "id": "gen-tool-memory-recall-seeded",
    "pack": "general",
    "mode": "tool",
    "live": false,
    "prompt": "Recall a seeded standing fact.",
    "setup": {
      "seedMemory": [
        { "text": "WiFi guest password hint is maple-orchid.", "target": "l2" }
      ]
    },
    "tool": {
      "name": "memory_recall",
      "args": { "query": "maple-orchid", "limit": 5 }
    },
    "expect": {
      "toolOk": true,
      "bodyMatching": "maple-orchid|guest password"
    }
  },
  {
    "id": "gen-tool-memory-recall-empty-query-refuse",
    "pack": "general",
    "mode": "tool",
    "live": false,
    "prompt": "Recall with empty query.",
    "tool": {
      "name": "memory_recall",
      "args": { "query": "  " },
      "refuse": true
    },
    "expect": {
      "refuseMatching": "query|bad_params|required"
    }
  },
  {
    "id": "gen-compose-memory-recall-answer-user",
    "pack": "general",
    "mode": "compose",
    "live": false,
    "prompt": "What is our coffee preference? Use memory_recall if needed.",
    "setup": {
      "seedMemory": [
        { "text": "Standing note: coffee preference is oat milk latte.", "target": "l2" }
      ]
    },
    "allowTools": ["memory_recall"],
    "rounds": [
      {
        "reply": "```envoyhome-tools\n[{\"tool\":\"memory_recall\",\"args\":{\"query\":\"oat\",\"limit\":5}}]\n```"
      },
      {
        "reply": "Your coffee preference is oat milk latte."
      }
    ],
    "expect": {
      "dispatchOrder": ["memory_recall"],
      "finalMatching": "oat milk"
    }
  },
  {
    "id": "gen-compose-memory-session-search-soft",
    "pack": "general",
