    }
  },
  {
    "id": "gen-live-memory-answer-from-standing",
    "pack": "general",
    "mode": "turn",
    "live": true,
    "purpose": "general",
    "setup": {
      "seedMemory": [
        {
          "text": "Agent-eval standing fact: favorite tea is jasmine green (token mem-jasmine-77).",
          "target": "l2"
        }
      ]
    },
    "prompt": "What is my favorite tea according to standing memory? If you do not see it in context, say you do not know — do not invent a tea.",
