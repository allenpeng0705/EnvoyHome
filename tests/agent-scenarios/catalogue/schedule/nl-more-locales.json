[
  {
    "id": "sched-nl-missing-time-asks",
    "pack": "schedule",
    "mode": "nl",
    "live": true,
    "locale": "en",
    "prompt": "Remind me to call mom",
    "expect": {
      "scheduleNl": { "ok": false },
      "liveTools": ["schedule", "ask_user"],
      "honestyMatching": ["when|time|clock|几点|何時|ask|need"]
    }
  },
  {
    "id": "sched-nl-every-day-8am",
