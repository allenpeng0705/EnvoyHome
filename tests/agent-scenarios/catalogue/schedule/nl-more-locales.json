    "mode": "nl",
    "live": true,
    "locale": "en",
    "prompt": "Remind me every day at 8:00 to drink water",
    "expect": {
      "scheduleNl": { "ok": true, "kind": "cron" },
      "liveTools": ["schedule"]
    }
  },
  {
