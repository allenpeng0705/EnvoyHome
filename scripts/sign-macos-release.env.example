# Copy to scripts/sign-macos-release.env (gitignored) and fill before any release DMG.
# Same Developer ID values as ../EnvoyMesh and ../EnvoyCoder (EnvoyDev).
# Operator guide: ../EnvoyMesh/docs/macos-mirror-signing.md
#
# Developer ID Application cert must be in Keychain:
#   security find-identity -v -p codesigning
#
# APPLE_PASSWORD = app-specific password (not your Apple ID password):
#   https://appleid.apple.com → Sign-In and Security → App-Specific Passwords

export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
export APPLE_ID="you@example.com"
export APPLE_PASSWORD="app-specific-password"
export APPLE_TEAM_ID="XXXXXXXXXX"
