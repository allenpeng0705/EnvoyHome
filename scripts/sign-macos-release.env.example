# Optional Apple Developer ID + notarization for scripts/build-desktop.sh (macOS DMG).
# Copy to scripts/sign-macos-release.env (gitignored) and fill in real values.
# Same shape as EnvoyMesh / EnvoyCoder.

export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
export APPLE_ID="you@example.com"
export APPLE_PASSWORD="app-specific-password"
export APPLE_TEAM_ID="TEAMID"
