{
  "name": "@envoyhome/fake-mqtt",
  "version": "0.0.0",
  "private": true,
  "description": "Local demo MQTT broker + device panel (not a real IoT fleet). For EnvoyHome demos alongside a real broker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "envoyhome-fake-mqtt": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "node ./dist/bin.js",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts"
  },
  "dependencies": {
    "aedes": "^0.51.3",
    "mqtt": "^5.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
