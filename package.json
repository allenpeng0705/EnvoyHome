{
  "name": "envoyhome",
  "version": "0.1.0",
  "private": true,
  "description": "EnvoyHome — self-hosted home agent control plane. Workspace root (B0).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "peers:check": "./scripts/peers-check.sh",
    "docs:lint": "node scripts/docs-lint.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:daemon": "pnpm --filter @envoyhome/daemon run dev",
    "ci": "./scripts/ci.sh",
    "fake:ha": "pnpm --filter @envoyhome/fake-ha build && pnpm --filter @envoyhome/fake-ha dev",
    "fake:mqtt": "pnpm --filter @envoyhome/fake-mqtt build && pnpm --filter @envoyhome/fake-mqtt dev",
    "demo:ha-smoke": "node ./scripts/demo-ha-smoke.mjs",
    "ha:c4-diff": "./scripts/ha-c4-diff.sh",
    "doctor:fresh": "./scripts/doctor-fresh.sh",
    "doctor:homeclaw": "./scripts/doctor-homeclaw-dryrun.sh",
    "smoke:rpc": "./scripts/smoke-rpc.sh",
    "smoke:v1": "node ./scripts/smoke-v1.mjs",
    "agent:eval": "./scripts/agent-eval.sh",
    "agent:eval:ws": "ENVOYHOME_AGENT_EVAL=1 node ./scripts/agent-eval-live.mjs",
    "agent:eval:live-direct": "ENVOYHOME_AGENT_EVAL_FILTER=live-llm ./scripts/agent-eval.sh",
    "agent:eval:docs": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-user ./scripts/agent-eval.sh",
    "agent:eval:web": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-web ./scripts/agent-eval.sh",
    "agent:eval:browser": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-browser ./scripts/agent-eval.sh",
    "agent:eval:memory": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-memory ./scripts/agent-eval.sh",
    "agent:eval:ask": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-ask ./scripts/agent-eval.sh",
    "agent:eval:p0": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-browser,gen-live-memory,gen-live-ask ./scripts/agent-eval.sh",
    "agent:eval:knowledge": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-knowledge ./scripts/agent-eval.sh",
    "agent:eval:knowyou": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-knowyou ./scripts/agent-eval.sh",
    "agent:eval:kb": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-knowledge,gen-live-knowyou ./scripts/agent-eval.sh",
    "agent:eval:home": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-home,gen-live-general-refuse-ha ./scripts/agent-eval.sh",
    "agent:eval:edit": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-edit,gen-live-apply-patch ./scripts/agent-eval.sh",
    "agent:eval:workflows": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-workflow ./scripts/agent-eval.sh",
    "agent:eval:abstain": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-abstain ./scripts/agent-eval.sh",
    "agent:eval:general-p0": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-home,gen-live-edit,gen-live-apply-patch,gen-live-workflow,gen-live-abstain,gen-live-general-refuse-ha ./scripts/agent-eval.sh",
    "agent:eval:jobs": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-job ./scripts/agent-eval.sh",
    "agent:eval:proactive": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-proactive ./scripts/agent-eval.sh",
    "agent:eval:exec": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-exec ./scripts/agent-eval.sh",
    "agent:eval:user-agent": "ENVOYHOME_AGENT_EVAL_FILTER=gen-live-job,gen-live-proactive,gen-live-exec ./scripts/agent-eval.sh",
    "test:web-search-browser": "pnpm --filter @envoyhome/daemon run test:web-search-browser",
    "agent:scenarios": "pnpm --filter @envoyhome/daemon run test:agent-scenarios",
    "desktop:dev": "./scripts/desktop-dev.sh",
    "desktop:tauri:build": "pnpm --filter @envoyhome/desktop tauri:build",
    "desktop:build": "./scripts/build-desktop.sh",
    "desktop:stage": "node ./scripts/stage-desktop-bundle.mjs",
    "version:desktop": "node ./scripts/sync-desktop-version.mjs",
    "version:desktop:check": "node ./scripts/sync-desktop-version.mjs --check",
    "mobile:test": "./scripts/mobile-test.sh",
    "mobile:live": "./scripts/mobile-live-smoke.sh",
    "mobile:flutter": "cd apps/mobile && flutter pub get && flutter test"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
